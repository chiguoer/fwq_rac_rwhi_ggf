（非常感谢您写的自动化ablation的脚本，给你提醒一点：
跑torchrun --nproc_per_node 2 train.py --config configs/racformer_with_rwhi_ggf.py时，
batch_size最好设置成2，因为这时候显存占用就有22~24G了，再翻倍就是44~48G，这超出了我们的显存46G）
  # 1) Baseline（原RaCFormer）
  torchrun --master_port 29601 --nproc_per_node 2 train.py \
    --config configs/racformer_r50_nuimg_704x256_f8.py

  # 2) 伪Baseline（走新代码路径，但RWHI/GGF全关）
  torchrun --master_port 29602 --nproc_per_node 2 train.py \
    --config configs/racformer_with_rwhi_ggf.py \
    --override \
    model.pts_bbox_head.use_rwhi=False \
    model.pts_bbox_head.rwhi_cfg.enabled=False \
    model.pts_bbox_head.ggf_cfg.enabled=False \
    model.pts_bbox_head.transformer.ggf_cfg.enabled=False


